# ==========================================
# DATABASE CONFIGURATION
# ==========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/inviteaura?retryWrites=true&w=majority

# ==========================================
# JWT & AUTHENTICATION
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==========================================
# CLOUDINARY (File Upload)
# ==========================================
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret

# ==========================================
# RAZORPAY (Payment Gateway)
# ==========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==========================================
# STRIPE (Payment Gateway)
# ==========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret

# ==========================================
# EMAIL CONFIGURATION (Gmail)
# ==========================================
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASSWORD=your_app_specific_password

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ==========================================
# ADMIN CREDENTIALS
# ==========================================
ADMIN_EMAIL=admin@inviteaura.com
ADMIN_PASSWORD=admin_secure_password_change_this

# ==========================================
# QR CODE CONFIGURATION
# ==========================================
QR_CODE_SIZE=200
QR_CODE_ERROR_CORRECTION=M

# ==========================================
# FILE UPLOAD LIMITS
# ==========================================
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,mp3,mp4,pdf

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# SUBSCRIPTION PLANS
# ==========================================
FREE_PLAN_TEMPLATES=5
FREE_PLAN_STORAGE=104857600
PREMIUM_PLAN_PRICE=999
PREMIUM_PLAN_TEMPLATES=unlimited
PREMIUM_PLAN_STORAGE=10737418240
